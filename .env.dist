# Copy to .env and adjust. Used by docker-compose.yml, which is for trying the
# image out and testing local builds.

# Image to run. Override to test a locally built one, e.g. IMAGE=php:local
#IMAGE=frugan/php-legacy:7.4-fpm

# Build parameters, for `docker compose build`. TARGET is fpm, fpm-dev, cli or
# cli-dev, and PHP_VARIANT must match it (fpm or cli).
#PHP_VERSION=7.4
#PHP_VARIANT=fpm
#TARGET=fpm

# Your ids, so that files written to ./html belong to you: id -u, id -g
#USER_ID=1000
#GROUP_ID=1000

# production, staging, develop... Outside production PHP reads
# .user-<APP_ENV>.ini instead of .user.ini.
#APP_ENV=develop

# Optional extensions: apcu igbinary imagick memcached msgpack pdo_pgsql pgsql redis soap
#PHP_EXTENSIONS=apcu,imagick,redis

#MAILPIT_HTTP_PORT=8025
