From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: docker-php-legacy <dev@frugan.it>
Date: Thu, 19 Nov 2026 21:46:17 +0100
Subject: [PATCH] Fix GHSA-gr4f-wgx5-jpfv: DATEG(tzcache) use-after-free

Backport of Remi Collet's 9a98666be1d3ba6b48e20593a68ca6f6e73e4dd6
on PHP-7.0-security-backports, not reviewed by the PHP Group.
Same change, with the TSRMLS_CC php_format_date() takes on 5.6.
---
 main/main.c | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/main/main.c b/main/main.c
index a478e31e..faf2d6a0 100644
--- a/main/main.c
+++ b/main/main.c
@@ -704,15 +704,7 @@ PHPAPI void php_log_err(char *log_message TSRMLS_DC)
 			char *error_time_str;
 
 			time(&error_time);
-#ifdef ZTS
-			if (!php_during_module_startup()) {
-				error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 1 TSRMLS_CC);
-			} else {
-				error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 0 TSRMLS_CC);
-			}
-#else
-			error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 1 TSRMLS_CC);
-#endif
+			error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, PG(modules_activated) && EG(active) TSRMLS_CC);
 			len = spprintf(&tmp, 0, "[%s] %s%s", error_time_str, log_message, PHP_EOL);
 #ifdef PHP_WIN32
 			php_flock(fd, 2);
